<?xml version="1.0"?>
<package format="3">
  <name>stretch_floor_perception</name>
  <version>0.0.1</version>
  <description>Floor object detection and 2D-to-3D projection for Stretch 2.</description>
  <maintainer email="agabas@iri.upc.edu">Antonio Gabas</maintainer>
  <license>GPL3.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  
  <depend>vision_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
  <build_type>ament_cmake</build_type>
  </export>

</package>
