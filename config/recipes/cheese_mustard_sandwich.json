{
  "recipe_id": "cheese_mustard_sandwich",
  "name": "Cheese and Mustard Sandwich",
  "ingredients": ["Mozzarella", "Mustard", "Butter", "Bread"],
  "tools": ["Plate", "Knife", "Cutting Board"],
  "steps": [
    {
      "name": "Cut bread open",
      "actions": [
        { "action": "pick", "args": { "object": "Bread" } },
        { "action": "place", "args": { "object": "Bread", "target": "Cutting Board" } },
        { "action": "pick", "args": { "object": "Knife" } },
        { "action": "cut", "args": { "tool": "Knife", "object": "Bread" } },
        { "action": "put_aside", "args": { "object": "Knife" } },
        { "action": "transfer", "args": { "source": "Cutting Board", "target": "Plate" } }
      ]
    },
    {
      "name": "Butter bread",
      "actions": [
        { "action": "pick", "args": { "object": "Knife" } },
        { "action": "spread", "args": { "tool": "Knife", "object": "Butter", "target": "Bread" } },
        { "action": "put_aside", "args": { "object": "Knife" } }
      ]
    },
    {
      "name": "Spread mustard",
      "actions": [
        { "action": "pick", "args": { "object": "Knife" } },
        { "action": "spread", "args": { "tool": "Knife", "object": "Mustard", "target": "Bread" } },
        { "action": "put_aside", "args": { "object": "Knife" } }
      ]
    },
    {
      "name": "Add mozzarella",
      "actions": [
        { "action": "pick", "args": { "object": "Mozzarella" } },
        { "action": "place", "args": { "object": "Mozzarella", "target": "Cutting Board" } },
        { "action": "pick", "args": { "object": "Knife" } },
        { "action": "cut", "args": { "tool": "Knife", "object": "Mozzarella" } },
        { "action": "put_aside", "args": { "object": "Knife" } },
        { "action": "transfer", "args": { "source": "Cutting Board", "target": "Plate" } }
      ]
    }
  ]
}