<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>speech_task</name>
  <version>0.1.0</version>
  <description>Speech to structured high-level robot tasks: audio capture, ASR, LLM interpretation with clarification/infeasibility handling.</description>
  <maintainer email="1056862@students.wits.ac.za">userlab</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>speech_task_interfaces</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- pip (see requirements.txt): faster-whisper, sounddevice, webrtcvad-wheels, anthropic -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
